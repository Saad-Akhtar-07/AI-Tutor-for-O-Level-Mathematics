            {
              "type": "text",
              "text": "Algebraic roots & indices"
            }
          ]
        },
        {
          "type": "heading",
          "level": 2,
          "content": [
            {
              "type": "text",
              "text": "What are the laws of indices?"
            }
          ]
        },
        {
          "type": "bullet_list",
          "items": [
            {
              "content": [
                {
                  "type": "text",
                  "text": "Index laws are rules you can use when doing operations with powers"
                }
              ]
            }
          ]
        },
        {
          "type": "bullet_list",
          "items": [
            {
              "content": [
                {
                  "type": "text",
                  "text": "They work with both numbers and algebra"
                }
              ]
            }
          ]
        },
        {
          "type": "table",
          "rows": [
            {
              "is_header": true,
              "cells": [
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Law"
                        }
                      ]
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Description"
                        }
                      ]
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "How it works"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "is_header": false,
              "cells": [
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "a^{1} = a",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Anything to the power of 1 is itself"
                        }
                      ]
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "x^{1} = x",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                }
              ]
            },
            {
              "is_header": false,
              "cells": [
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "a^{0} = 1",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Anything to the power of 0 is 1"
                        }
                      ]
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "b^{0} = 1",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                }
              ]
            },
            {
              "is_header": false,
              "cells": [
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "a^{m} \\times a^{n} = a^{m+n}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "To multiply indices with the same base, add their powers"
                        }
                      ]
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "c^{3} \\times c^{2}",
                      "display": true,
                      "needs_review": false
                    },
                    {
                      "type": "math",
                      "latex": "= (c \\times c \\times c) \\times (c \\times c)",
                      "display": true,
                      "needs_review": false
                    },
                    {
                      "type": "math",
                      "latex": "= c^{5}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                }
              ]
            },
            {
              "is_header": false,
              "cells": [
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "a^{m} \\div a^{n} = \\frac{a^{m}}{a^{n}} = a^{m-n}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "To divide indices with the same base, subtract their powers"
                        }
                      ]
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "d^{5} \\div d^{2}",
                      "display": true,
                      "needs_review": false
                    },
                    {
                      "type": "math",
                      "latex": "= \\frac{d \\times d \\times d \\times \\cancel{d} \\times \\cancel{d}}{\\cancel{d} \\times \\cancel{d}}",
                      "display": true,
                      "needs_review": false
                    },
                    {
                      "type": "math",
                      "latex": "= d^{3}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                }
              ]
            },
            {
              "is_header": false,
              "cells": [
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "(a^{m})^{n} = a^{mn}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "To raise indices to a new power, multiply their powers"
                        }
                      ]
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "(e^{3})^{2}",
                      "display": true,
                      "needs_review": false
                    },
                    {
                      "type": "math",
                      "latex": "= (e \\times e \\times e) \\times (e \\times e \\times e)",
                      "display": true,
                      "needs_review": false
                    },
                    {
                      "type": "math",
                      "latex": "= e^{6}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                }
              ]
            },
            {
              "is_header": false,
              "cells": [
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "(ab)^{n} = a^{n}b^{n}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "To raise a product to a power, apply the power to both numbers, and multiply"
                        }
                      ]
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "(f \\times g)^{2}",
                      "display": true,
                      "needs_review": false
                    },
                    {
                      "type": "math",
                      "latex": "= f^{2} \\times g^{2}",
                      "display": true,
                      "needs_review": false
                    },
                    {
                      "type": "math",
                      "latex": "= f^{2}g^{2}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                }
              ]
            },
            {
              "is_header": false,
              "cells": [
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "\\left(\\frac{a}{b}\\right)^{n} = \\frac{a^{n}}{b^{n}}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "To raise a fraction to a power, apply the power to both the numerator and denominator"
                        }
                      ]
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "\\left(\\frac{h}{i}\\right)^{2} = \\frac{h^{2}}{i^{2}}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                }
              ]
            },
            {
              "is_header": false,
              "cells": [
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "a^{-1} = \\frac{1}{a}",
                      "display": true,
                      "needs_review": false
                    },
                    {
                      "type": "math",
                      "latex": "a^{-n} = \\frac{1}{a^{n}}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A negative power is the reciprocal"
                        }
                      ]
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "j^{-1} = \\frac{1}{j}",
                      "display": true,
                      "needs_review": false
                    },
                    {
                      "type": "math",
                      "latex": "k^{-3} = \\frac{1}{k^{3}}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "page_number": 3,
      "blocks": [
        {
          "type": "table",
          "rows": [
            {
              "is_header": false,
              "cells": [
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "\\left(\\frac{a}{b}\\right)^{-n} = \\left(\\frac{b}{a}\\right)^{n} = \\frac{b^{n}}{a^{n}}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A fraction to a negative power, is the reciprocal of the fraction, to the positive power"
                        }
                      ]
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "\\left(\\frac{l}{m}\\right)^{-3} = \\left(\\frac{m}{l}\\right)^{3} = \\frac{m^{3}}{l^{3}}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                }
              ]
            },
            {
              "is_header": false,
              "cells": [
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "a^{\\frac{1}{n}} = \\sqrt[n]{a}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "The fractional power "
                        },
                        {
                          "type": "math",
                          "latex": "\\frac{1}{n}"
                        },
                        {
                          "type": "text",
                          "text": " is the "
                        },
                        {
                          "type": "math",
                          "latex": "n^{\\text{th}}"
                        },
                        {
                          "type": "text",
                          "text": " root ( "
                        },
                        {
                          "type": "math",
                          "latex": "\\sqrt[n]{}"
                        },
                        {
                          "type": "text",
                          "text": " )"
                        }
                      ]
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "n^{\\frac{1}{2}} = \\sqrt{n}",
                      "display": true,
                      "needs_review": false
                    },
                    {
                      "type": "math",
                      "latex": "p^{\\frac{1}{3}} = \\sqrt[3]{p}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                }
              ]
            },
            {
              "is_header": false,
              "cells": [
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "a^{-\\frac{1}{n}} = \\frac{1}{a^{\\frac{1}{n}}} = \\frac{1}{\\sqrt[n]{a}}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "A negative, fractional power is one over a root"
                        }
                      ]
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "q^{-\\frac{1}{2}} = \\frac{1}{\\sqrt{q}}",
                      "display": true,
                      "needs_review": false
                    },
                    {
                      "type": "math",
                      "latex": "r^{-\\frac{1}{3}} = \\frac{1}{\\sqrt[3]{r}}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                }
              ]
            },
            {
              "is_header": false,
              "cells": [
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "\\begin{aligned}a^{\\frac{m}{n}} &= a^{\\frac{1}{n} \\times m} \\\\ &= \\left(a^{\\frac{1}{n}}\\right)^{m} = \\left(\\sqrt[n]{a}\\right)^{m} \\\\ &= \\left(a^{m}\\right)^{\\frac{1}{n}} = \\sqrt[n]{a^{m}}\\end{aligned}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "The fractional power "
                        },
                        {
                          "type": "math",
                          "latex": "\\frac{m}{n}"
                        },
                        {
                          "type": "text",
                          "text": " is the "
                        },
                        {
                          "type": "math",
                          "latex": "n^{\\text{th}}"
                        },
                        {
                          "type": "text",
                          "text": " root all to the power "
                        },
                        {
                          "type": "math",
                          "latex": "m"
                        },
                        {
                          "type": "text",
                          "text": ", "
                        },
                        {
                          "type": "math",
                          "latex": "\\left(\\sqrt[n]{}\\right)^{m}"
                        },
                        {
                          "type": "text",
                          "text": ", or the "
                        },
                        {
                          "type": "math",
                          "latex": "n^{\\text{th}}"
                        },
                        {
                          "type": "text",
                          "text": " root of the power "
                        },
                        {
                          "type": "math",
                          "latex": "m"
                        },
                        {
                          "type": "text",
                          "text": ", "
                        },
                        {
                          "type": "math",
                          "latex": "\\sqrt[n]{(\\ )^{m}}"
                        },
                        {
                          "type": "text",
                          "text": " (both are the same)"
                        }
                      ]
                    }
                  ]
                },
                {
                  "blocks": [
                    {
                      "type": "math",
                      "latex": "s^{\\frac{2}{3}} = \\left(s^{\\frac{1}{3}}\\right)^{2} = \\left(\\sqrt[3]{s}\\right)^{2}",
                      "display": true,
                      "needs_review": false
                    },
                    {
                      "type": "math",
                      "latex": "s^{\\frac{2}{3}} = \\left(s^{2}\\right)^{\\frac{1}{3}} = \\sqrt[3]{s^{2}}",
                      "display": true,
                      "needs_review": false
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "bullet_list",
          "items": [
            {
              "content": [
                {
                  "type": "text",
                  "text": "These can be used to **simplify** expressions"
                }
              ]
            }
          ]
        },
        {
          "type": "bullet_list",
          "items": [
            {
              "content": [
                {
                  "type": "text",
                  "text": "Work out the **number** and **algebra** parts **separately**"
                }
              ]
            }
          ]
        },
        {
          "type": "bullet_list",
          "items": [
            {
              "content": [
                {
                  "type": "math",
                  "latex": "(3x^{7}) \\times (6x^{4}) = (3 \\times 6) \\times (x^{7} \\times x^{4}) = 18x^{7+4} = 18x^{11}"
                }
              ]
            },
            {
              "content": [
                {
                  "type": "math",
                  "latex": "\\frac{6x^{7}}{3x^{4}} = \\frac{6}{3} \\times \\frac{x^{7}}{x^{4}} = 2x^{7-4} = 2x^{3}"
                }
              ]
            },
            {
              "content": [
                {
                  "type": "math",
                  "latex": "(3x^{7})^{2} = (3)^{2} \\times (x^{7})^{2} = 9x^{14}"
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "level": 1,
          "content": [
            {
              "type": "text",
              "text": "How do I find an unknown inside a power?"
            }
          ]
        },
        {
          "type": "bullet_list",
          "items": [
            {
              "content": [
                {
                  "type": "text",
                  "text": "A term may have a **power involving an unknown**"
                }
              ]
            },
            {
              "content": [
                {
                  "type": "text",
                  "text": "E.g. "
                },
                {
                  "type": "math",
                  "latex": "7^{4x}"
                }
              ]
            }
          ]
        },
        {
          "type": "bullet_list",
          "items": [
            {
              "content": [
                {
                  "type": "text",
                  "text": "If both sides of an equation have the **same base number**, then the powers must be equal"
                }
              ]
            },
            {
              "content": [
                {
                  "type": "text",
                  "text": "E.g. If "
                },
                {
                  "type": "math",
                  "latex": "4^{3x} = 4^{9}"
                },
                {
                  "type": "text",
                  "text": " then "
                },
                {
                  "type": "math",
                  "latex": "3x = 9"
                }
              ]
            },
            {
              "content": [
                {
                  "type": "text",
                  "text": "And "
                },
                {
                  "type": "math",
                  "latex": "x = 3"
                }
              ]
            }
          ]
        },
        {
          "type": "bullet_list",
          "items": [
            {
              "content": [
                {
                  "type": "text",
                  "text": "You may have to do some **simplifying first** to reach this point"
                }
              ]
            },
            {
              "content": [
                {
                  "type": "text",
                  "text": "E.g. "
                },
                {
                  "type": "math",
                  "latex": "3^{2x} \\times 3^{4} = 3^{18}"
                },
                {
                  "type": "text",
                  "text": " simplifies to "
                },
                {
                  "type": "math",
                  "latex": "3^{2x+4} = 3^{18}"
                }
              ]
            },
            {
              "content": [
                {
                  "type": "text",
                  "text": "Therefore "
                },
                {
                  "type": "math",
                  "latex": "2x + 4 = 18"
                }
              ]
            },
            {
              "content": [
                {
                  "type": "text",
                  "text": "And "
                },
                {
                  "type": "math",
                  "latex": "x = 7"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "page_number": 4,
      "blocks": [
        {
          "type": "heading",
          "level": 2,
          "content": [
            {
              "type": "text",
              "text": "Worked Example"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "(a) Simplify "
            },
            {
              "type": "math",
              "latex": "(u^5)^5"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Answer:"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "math",
              "latex": "(a^m)^n = a^{mn}"
            }
          ]
        },
        {
          "type": "math",
          "latex": "(u^5)^5 = u^{5 \\times 5}",
          "display": true,
          "needs_review": false
        },
        {
          "type": "math",
          "latex": "u^{25}",
          "display": true,
          "needs_review": false
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "(b) If "
            },
            {
              "type": "math",
              "latex": "q^x = \\frac{q^2 \\times q^5}{q^{10}}"
            },
            {
              "type": "text",
              "text": " find "
            },
            {
              "type": "math",
              "latex": "x"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Answer:"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "math",
              "latex": "a^m \\times a^n = a^{m+n}"
            },
            {
              "type": "text",
              "text": " to simplify the numerator"
            }
          ]
        },
        {
          "type": "math",
          "latex": "q^2 \\times q^5 = q^{2+5} = q^7",
          "display": true,
          "needs_review": false
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "math",
              "latex": "\\frac{a^m}{a^n} = a^{m-n}"
            },
            {
              "type": "text",
              "text": " to simplify the fraction"
            }
          ]
        },
        {
          "type": "math",
          "latex": "\\frac{q^7}{q^{10}} = q^{7-10} = q^{-3}",
          "display": true,
          "needs_review": false
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Write out both sides of the equation"
            }
          ]
        },
        {
          "type": "math",
          "latex": "q^x = q^{-3}",
          "display": true,
          "needs_review": false
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Both sides are now over the same base of "
            },
            {
              "type": "math",
              "latex": "q"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "So "
            },
            {
              "type": "math",
              "latex": "x"
            },
            {
              "type": "text",
              "text": " must equal the power on the right-hand side"
            }
          ]
        },
        {
          "type": "math",
          "latex": "x = -3",
          "display": true,
          "needs_review": false
        },
        {
          "type": "heading",
          "level": 2,
          "content": [
            {
              "type": "text",
              "text": "Worked Example"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "(a) Rewrite "
            },
            {
              "type": "math",
              "latex": "\\frac{1}{\\sqrt[3]{x^4}}"
            },
            {
              "type": "text",
              "text": " in the form "
            },
            {
              "type": "math",
              "latex": "x^n"
            },
            {
              "type": "text",
              "text": " where "
            },
            {
              "type": "math",
              "latex": "n"
            },
            {
              "type": "text",
              "text": " is a negative fraction."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Answer:"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "math",
              "latex": "a^{\\frac{1}{n}} = \\sqrt[n]{a}"
            },
            {
              "type": "text",
              "text": " to rewrite the cube-root as a power of "
            },
            {
              "type": "math",
              "latex": "\\frac{1}{3}"
            }
          ]
        },
        {
          "type": "math",
          "latex": "\\frac{1}{(x^4)^{\\frac{1}{3}}}",
          "display": true,
          "needs_review": false
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "math",
              "latex": "(a^m)^n = a^{mn}"
            },
            {
              "type": "text",
              "text": " to simplify the denominator"
            }
          ]
        }
      ]
    },
    {
      "page_number": 5,
      "blocks": [
        {
          "type": "math",
          "latex": "\\frac{1}{x^{\\frac{4}{3}}}",
          "display": true,
          "needs_review": false
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "math",
              "latex": "a^{-n} = \\frac{1}{a^{n}}"
            },
            {
              "type": "text",
              "text": " to rewrite as a term with a negative fraction as the power"
            }
          ]
        },
        {
          "type": "math",
          "latex": "x^{-\\frac{4}{3}}",
          "display": true,
          "needs_review": false
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "(b) Find the value of the constants "
            },
            {
              "type": "math",
              "latex": "m"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "math",
              "latex": "a"
            },
            {
              "type": "text",
              "text": " given that "
            },
            {
              "type": "math",
              "latex": "\\left( ax^{6} \\right)^{\\frac{1}{m}} = 8x^{3}"
            },
            {
              "type": "text",
              "text": "."
            }
          ]
        },
        {
          "type": "heading",
          "level": 3,
          "content": [
            {
              "type": "text",
              "text": "Answer:"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "math",
              "latex": "(ab)^{n} = a^{n}b^{n}"
            },
            {
              "type": "text",
              "text": " to rewrite the left hand side"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Remember to apply the power to both "
            },
            {
              "type": "math",
              "latex": "a"
            },
            {
              "type": "text",
              "text": " and "
            },
            {
              "type": "math",
              "latex": "x^{6}"
            }
          ]
        },
        {
          "type": "math",
          "latex": "a^{\\frac{1}{m}} \\times x^{\\frac{6}{m}} = 8x^{3}",
          "display": true,
          "needs_review": false
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Both sides of the equation have a constant part, "
            },
            {
              "type": "math",
              "latex": "a^{\\frac{1}{m}}"
            },
            {
              "type": "text",
              "text": " and 8"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "And both sides of the equation have a part in terms of "
            },
            {
              "type": "math",
              "latex": "x"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The two sides of the equation are equal, so set the respective parts equal to one another"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "First,"
            }
          ]
        },
        {
          "type": "math",
          "latex": "x^{\\frac{6}{m}} = x^{3}",
          "display": true,
          "needs_review": false
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The bases are the same, therefore the powers are equal"
            }
          ]
        },
        {
          "type": "math",
          "latex": "\\frac{6}{m} = 3",
          "display": true,
          "needs_review": false
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Solve to find "
            },
            {
              "type": "math",
              "latex": "m"
            }
          ]
        },
        {
          "type": "math",
          "latex": "m = 2",
          "display": true,
          "needs_review": false
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Then set the constant parts of both sides equal to one another"
            }
          ]
        },
        {
          "type": "math",
          "latex": "a^{\\frac{1}{m}} = 8",
          "display": true,
          "needs_review": false
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "We now know that "
            },
            {
              "type": "math",
              "latex": "m = 2"
            },
            {
              "type": "text",
              "text": ", so substitute this in"
            }
          ]
        },
        {
          "type": "math",
          "latex": "a^{\\frac{1}{2}} = 8",
          "display": true,
          "needs_review": false
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Use "
            },
            {
              "type": "math",
              "latex": "a^{\\frac{1}{n}} = \\sqrt[n]{a}"
            },
            {
              "type": "text",
              "text": " to rewrite as a square root"
            }
          ]
        },
        {
          "type": "math",
          "latex": "\\sqrt[2]{a} = 8",
          "display": true,
          "needs_review": false
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Find "
            },
            {
              "type": "math",
              "latex": "a"
            },
            {
              "type": "text",
              "text": " by squaring both sides"
            }
          ]
        }
      ]
    },
