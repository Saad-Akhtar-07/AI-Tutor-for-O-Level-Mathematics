DATABASE_URL=postgresql://ai_tutor_app:replace_me@localhost:5433/ai_tutor
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The backend also reads OPENROUTER_API_KEY from the project-root .env when it
# is not present here. Keep real keys out of source control.
OPENROUTER_API_KEY=

# The free router is convenient for local testing. Pin tested exact model IDs
# before the public demo so marking behavior stays consistent.
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_EVALUATION_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=90
