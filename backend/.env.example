DATABASE_URL=postgresql://ai_tutor_app:replace_me@localhost:5433/ai_tutor
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The backend also reads OPENROUTER_API_KEY from the project-root .env when it
# is not present here. Keep real keys out of source control.
OPENROUTER_API_KEY=

# Groq Free tier: text tutoring and assessment. With auto, a configured Groq
# key takes priority; OpenRouter is the backup. Keep keys server-side.
GROQ_API_KEY=
AI_TEXT_PROVIDER=auto
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_EVALUATION_MODEL=openai/gpt-oss-120b

# Optional local speech worker. Run voice-setup.cmd once before starting the API.
# These settings do not disable voice transcription or text tutoring.
VOICE_WORKER_ENABLED=true
VOICE_WORKER_PORT=8765

# Photos use OpenRouter: the tested Groq account has no vision model available.
# These free model IDs were checked against the live catalog on 2026-09-16.
AI_VISION_PROVIDER=openrouter
OPENROUTER_VISION_MODEL=nex-agi/nex-n2.5-mini:free
OPENROUTER_EVALUATION_MODEL=nex-agi/nex-n2.5-mini:free
OPENROUTER_CHAT_MODEL=nex-agi/nex-n2.5-mini:free
OPENROUTER_VISION_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free,nex-agi/nex-n2.5-pro:free
OPENROUTER_EVALUATION_FALLBACK_MODELS=nex-agi/nex-n2.5-pro:free,openrouter/free
OPENROUTER_CHAT_FALLBACK_MODELS=nex-agi/nex-n2.5-pro:free,openrouter/free
# Privacy filtering applies to OpenRouter only. Groq has its own account policy.
# Some free OpenRouter endpoints require allow; change only with informed consent.
OPENROUTER_DATA_COLLECTION=deny
# Per-attempt wall-clock limit, capped at 30s (including legacy 90s values).
OPENROUTER_TIMEOUT_SECONDS=22
# Shared across retries/providers; image reviews share one vision+marking budget.
TUTOR_CHAT_BUDGET_SECONDS=35
TUTOR_REVIEW_BUDGET_SECONDS=65
