            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "(b) Find the probability that the spinner lands on green or purple."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Answer:"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "As the spinner cannot land on green and purple at the same time they are mutually exclusive"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "This means you can add their probabilities together"
                }
              ]
            },
            {
              "type": "math",
              "latex": "0.1 + 0.4 = 0.5",
              "display": true,
              "needs_review": true
            },
            {
              "type": "math",
              "latex": "\\mathrm{P}(\\text{Green or Purple}) = 0.5",
              "display": true,
              "needs_review": true
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "(c) Find the probability that the spinner does not land on yellow."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Answer:"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The probability of not landing on yellow is equal to 1 minus the probability of landing on yellow"
                }
              ]
            },
            {
              "type": "math",
              "latex": "1 - 0.2 = 0.8",
              "display": true,
              "needs_review": true
            },
            {
              "type": "math",
              "latex": "\\mathrm{P}(\\text{Not Yellow}) = 0.8",
              "display": true,
              "needs_review": true
            }
          ]
        }
      ]
    }
  ]
}