        },
        {
          "id": "q02.b.ii",
          "label": "(b)(ii)",
          "marks": 4,
          "prompt": [{ "type": "paragraph", "content": "Calculate the probability that the sweets she chooses are not both the same colour." }],
          "mark_scheme": {
            "answer": "$\\frac{258}{380}$ or equivalent",
            "marking_points": [
