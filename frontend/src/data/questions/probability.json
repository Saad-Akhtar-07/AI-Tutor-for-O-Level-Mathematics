        {
          "id": "q02.b.i",
          "label": "(b)(i)",
          "marks": 2,
          "prompt": [{ "type": "paragraph", "content": "Sonia chooses two sweets at random, without replacement, from her bag. Show that the probability that she chooses two green sweets is $\\frac{3}{38}$." }],
          "mark_scheme": {
            "answer": "$\\frac{30}{380}=\\frac{3}{38}$",
            "marking_points": [
              { "code": "M1", "text": "Uses $\\frac{6}{20}\\times\\frac{5}{19}$." },
              { "code": "A1", "text": "Obtains $\\frac{30}{380}$ or an equivalent form." }
